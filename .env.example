# Copy to .env and fill in. Never commit .env. All values below are placeholders.

# Which profiles/profiles.yml output to use: duckdb (default), snowflake or redshift.
DBT_TARGET=duckdb

# DuckDB (local default)
DUCKDB_PATH=warehouse/harbor_point.duckdb

# Snowflake (not exercised in CI)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_DATABASE=HARBOR_POINT
SNOWFLAKE_SCHEMA=ANALYTICS

# Redshift (not exercised in CI)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DATABASE=harbor_point
REDSHIFT_SCHEMA=analytics
